<script>
  
    var datosAlumno=JSON.parse('<?= $this->alumnos ?>');
    console.log(datosAlumno);


    
  var $contenedorCardsAlumnos = $("#contenedor-cards-alumno");

  function agregarCardAlumno(nombre, sexo, edad, imagen_alumno) {
    var $card = $(`
      <div class="col-md-3 mb-4 col-lg-3">
        <div class="card shadow-sm border-0">
          <img class="card-img-top rounded-top" src="<?= PLANTILLA ?>img/${imagen_alumno}" alt="Nombre: ${nombre}">
          <div class="card-body">
            <h5 class="card-title text-success">
              <i class="fa-solid fa-person"></i> ${nombre}
            </h5>
            <p class="card-text mb-2">
              <i class="fa-solid fa-person-half-dress text-primary"></i> <b>Sexo:</b> ${sexo}<br>
              <i class="fa-solid fa-file-alt text-warning"></i> <b>Edad:</b> ${edad}
            </p>

           
          </div>
        </div>
      </div>
    `);

    $contenedorCardsAlumnos.append($card);
  }

  for (let i = 0; i < datosAlumno.length; i++) {
    let nombre = datosAlumno[i]['primerNombre'];
    let edad = datosAlumno[i]['edad'];
    let sexo = datosAlumno[i]['sexo'];
    let imagen_alumno = datosAlumno[i]['imagen'];

    agregarCardAlumno(nombre, sexo, edad, imagen_alumno);
  }



</script>